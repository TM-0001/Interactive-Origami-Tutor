# 青い三角形 ＋ 手が写っていない
import cv2
import numpy as np
import mediapipe as mp


def check_origami():

    # =========================================
    # カメラ
    # =========================================

    cap = cv2.VideoCapture(0)


    # =========================================
    # MediaPipe Hands
    # =========================================

    mp_hands = mp.solutions.hands
    mp_draw = mp.solutions.drawing_utils

    hands = mp_hands.Hands(
        static_image_mode=False,
        max_num_hands=2,
        min_detection_confidence=0.5,
        min_tracking_confidence=0.5
    )


    # =========================================
    # 5フレーム連続True用
    # =========================================

    true_count = 0


    while True:

        ret, frame = cap.read()

        if not ret:
            break


        # =========================================
        # ① 青色の検出
        # =========================================

        hsv = cv2.cvtColor(
            frame,
            cv2.COLOR_BGR2HSV
        )

        lower_blue = np.array([90, 50, 50])
        upper_blue = np.array([150, 255, 255])

        mask = cv2.inRange(
            hsv,
            lower_blue,
            upper_blue
        )


        # =========================================
        # ② マスクのノイズ除去
        # =========================================

        kernel = np.ones(
            (5, 5),
            np.uint8
        )

        mask = cv2.morphologyEx(
            mask,
            cv2.MORPH_OPEN,
            kernel
        )

        mask = cv2.morphologyEx(
            mask,
            cv2.MORPH_CLOSE,
            kernel
        )


        # =========================================
        # ③ 青色の輪郭を検出
        # =========================================

        contours, hierarchy = cv2.findContours(
            mask,
            cv2.RETR_EXTERNAL,
            cv2.CHAIN_APPROX_SIMPLE
        )


        # =========================================
        # ④ 青い三角形か判定
        # =========================================

        is_triangle = False

        if len(contours) > 0:

            # 一番大きい青色の輪郭
            largest_contour = max(
                contours,
                key=cv2.contourArea
            )

            # 面積
            area = cv2.contourArea(
                largest_contour
            )

            # 輪郭の長さ
            perimeter = cv2.arcLength(
                largest_contour,
                True
            )

            # 多角形近似
            epsilon = 0.02 * perimeter

            approx = cv2.approxPolyDP(
                largest_contour,
                epsilon,
                True
            )

            # 3頂点なら三角形
            if len(approx) == 3:

                is_triangle = True


            # =====================================
            # 青い紙の輪郭を表示
            # =====================================

            cv2.drawContours(
                frame,
                [largest_contour],
                -1,
                (255, 0, 0),
                3
            )


            # =====================================
            # 三角形の輪郭を表示
            # =====================================

            if is_triangle:

                cv2.drawContours(
                    frame,
                    [approx],
                    -1,
                    (0, 0, 255),
                    5
                )


        # =========================================
        # ⑤ MediaPipeで手を検出
        # =========================================

        rgb = cv2.cvtColor(
            frame,
            cv2.COLOR_BGR2RGB
        )

        results = hands.process(rgb)


        # =========================================
        # ⑥ 手が写っているか判定
        # =========================================

        if results.multi_hand_landmarks:

            hands_visible = True

            # 手の骨格をカメラ画面に表示
            for hand_landmarks in results.multi_hand_landmarks:

                mp_draw.draw_landmarks(
                    frame,
                    hand_landmarks,
                    mp_hands.HAND_CONNECTIONS
                )

        else:

            hands_visible = False


        # =========================================
        # ⑦ 1フレームの判定
        # =========================================

        # 条件：
        # ① 青い三角形が写っている
        # ② 手が写っていない

        if is_triangle and not hands_visible:

            result = True

        else:

            result = False


        # =========================================
        # ⑧ 5フレーム連続判定
        # =========================================

        if result:

            true_count += 1

        else:

            true_count = 0


        # =========================================
        # ⑨ 結果表示
        # =========================================

        print(result)


        if result:

            cv2.putText(
                frame,
                f"TRUE {true_count}/5",
                (50, 80),
                cv2.FONT_HERSHEY_SIMPLEX,
                2,
                (0, 255, 0),
                4
            )

        else:

            cv2.putText(
                frame,
                "FALSE",
                (50, 80),
                cv2.FONT_HERSHEY_SIMPLEX,
                2,
                (0, 0, 255),
                4
            )


        # =========================================
        # ⑩ 5フレーム連続True
        # =========================================

        if true_count >= 5:

            print("5フレーム連続True")

            cap.release()
            hands.close()
            cv2.destroyAllWindows()

            return True


        # =========================================
        # ⑪ カメラ画面
        # =========================================

        cv2.imshow(
            "Camera",
            frame
        )


        # =========================================
        # ⑫ 青色マスク
        # =========================================

        cv2.imshow(
            "Mask",
            mask
        )


        # =========================================
        # ⑬ qキーで終了
        # =========================================

        if cv2.waitKey(1) & 0xFF == ord("q"):

            break


    # =========================================
    # 終了処理
    # =========================================

    cap.release()
    hands.close()
    cv2.destroyAllWindows()

    return False
